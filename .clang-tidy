# clang-tidy configuration for the nucleus first-party tree.
#
# Checks is the family floor -- the bugprone / cppcoreguidelines / performance /
# portability families as wildcards -- plus misc / modernize / readability, minus
# a small set of house-style opt-outs. clang-tidy has no comment syntax inside the
# Checks value, so each opt-out is justified on the comma-terminated line beneath
# it: that line matches no check and is ignored by the engine while a human reads
# it as the reason. Keep reason prose free of commas so it stays a single token.
#
# Globals disposition: a tree-wide grep for namespace-scope statics / constinit
# found none -- the first-party library carries no static or global objects at
# all -- so cppcoreguidelines-interfaces-global-init and
# bugprone-dynamic-static-initializers are kept enabled (they simply have nothing
# to fire on) rather than opted out. bugprone-use-after-move and bugprone-dangling-handle
# are deliberately kept: views-into-freed-buffers is the library's primary memory risk.
---
Checks: >
  -*,
  bugprone-*,
  cppcoreguidelines-*,
  performance-*,
  portability-*,
  misc-*,
  modernize-*,
  readability-*,
  -modernize-use-trailing-return-type,
  # leading return types are the house style (matches std / asio / boost),
  -modernize-use-nodiscard,
  # deliberate prior decision; churny across a large value-returning API,
  -cppcoreguidelines-use-default-member-init,
  # members are initialized in the constructor initializer list as a deliberate house rule giving one source of truth and this check is that rule's direct negation so no formulation satisfies both,
  -modernize-use-default-member-init,
  # alias of the cppcoreguidelines check directly above,
  -readability-identifier-length,
  # would flag idiomatic short names such as i / t / f,
  -readability-magic-numbers,
  # in a test-heavy tree literal constants are signal not noise,
  -cppcoreguidelines-avoid-magic-numbers,
  # same rationale as readability-magic-numbers,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  # the tokenizer / lexer does idiomatic pointer and iterator arithmetic,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  # bounds-profile friction with a high false-positive rate here,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  # bounds-profile friction with a high false-positive rate here,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  # value-semantics types and customization-point objects legitimately hold const / ref members,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  # fights POD-ish value types and the flat-ownership registries,
  -misc-non-private-member-variables-in-classes,
  # duplicate of the cppcoreguidelines check directly above,
  -cppcoreguidelines-avoid-do-while,
  # do / while is a legitimate idiom and is rare in this tree,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  # same bounds-profile friction as the pro-bounds trio disabled above,
  -readability-braces-around-statements,
  # the tree's consistent house idiom is brace-less single-statement control flow,
  -readability-inconsistent-ifelse-braces,
  # same brace-less single-statement idiom as the check directly above,
  -readability-implicit-bool-conversion,
  # idiomatic pointer / integer truthiness in conditions is intentional here,
  -readability-function-cognitive-complexity,
  # a tunable metric threshold rather than a defect,
  -readability-use-anyofallof,
  # a loop-to-algorithm rewrite is a readability preference that can reduce clarity,
  -misc-include-cleaner,
  # include-what-you-use is a separate discipline with false positives on transitive and standard headers,
  -misc-no-recursion,
  # schema and document tree traversal is legitimately recursive,
  -modernize-use-designated-initializers,
  # positional aggregate initialization is idiomatic here and designators are not mandated,
  -modernize-use-ranges,
  # range-algorithm rewrites are churny and the std iterator-pair forms read clearly,
  -bugprone-easily-swappable-parameters,
  # a high-noise heuristic that flags adjacent same-typed parameters rather than a defect,
  -readability-named-parameter,
  # tag-type and unused copy / move parameters are idiomatically left unnamed,
  -modernize-return-braced-init-list,
  # naming the return type in the return expression is clearer than a bare braced-init-list,
  -performance-enum-size,
  # pinning small public enums to a 1-byte base is an ABI commitment with negligible benefit that couples forward declarations,
  -bugprone-exception-escape,
  # flags noexcept accessors and internal frame-pop callbacks whose no-throw guarantee is hidden behind std::function and std::variant type erasure the analyzer cannot see through
WarningsAsErrors: '*'
HeaderFilterRegex: 'lib/(core|xml|env|argv|runtime)/(include|src)/nucleus/'
