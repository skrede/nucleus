function(single_match content pattern what path out)
    string(REGEX MATCHALL "${pattern}" matches "${content}")
    list(LENGTH matches count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "${path}: expected exactly one ${what}, found ${count}")
    endif()
    set(${out} "${matches}" PARENT_SCOPE)
endfunction()

function(collapse_whitespace text out)
    string(REGEX REPLACE "[ \t\r\n]+" " " collapsed "${text}")
    set(${out} "${collapsed}" PARENT_SCOPE)
endfunction()

function(find_package_call path out)
    file(READ "${path}" content)
    single_match("${content}" "find_package\\(nucleus[^)]*\\)" "find_package(nucleus ...) call" "${path}" call)
    collapse_whitespace("${call}" call)
    set(${out} "${call}" PARENT_SCOPE)
endfunction()

function(pin_field block field path out)
    single_match("${block}" "${field} [^ )]+" "${field} in its FetchContent_Declare(nucleus ...) block" "${path}" match)
    string(REPLACE "${field} " "" value "${match}")
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

function(vendoring_pin path repo_out tag_out)
    file(READ "${path}" content)
    single_match("${content}" "FetchContent_Declare\\(nucleus[^)]*\\)" "FetchContent_Declare(nucleus ...) block" "${path}" block)
    string(REGEX REPLACE "#[^\n]*" "" block "${block}")
    collapse_whitespace("${block}" block)
    pin_field("${block}" GIT_REPOSITORY "${path}" repo)
    pin_field("${block}" GIT_TAG "${path}" tag)
    set(${repo_out} "${repo}" PARENT_SCOPE)
    set(${tag_out} "${tag}" PARENT_SCOPE)
endfunction()

function(project_version path out)
    file(READ "${path}" content)
    set(pattern "project\\(nucleus[ \t\r\n]+VERSION[ \t\r\n]+[0-9]+\\.[0-9]+\\.[0-9]+")
    single_match("${content}" "${pattern}" "project(nucleus VERSION ...) line" "${path}" line)
    string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+$" version "${line}")
    set(${out} "${version}" PARENT_SCOPE)
endfunction()
