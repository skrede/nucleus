@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# The XML source module links pugixml PRIVATELY, but because it is a static
# archive the dependency survives in the exported link interface as
# $<LINK_ONLY:pugixml::pugixml>. The imported target therefore references the
# pugixml target, so a consumer of the export must be able to resolve it. The
# core library carries no such dependency; this is required only when the XML
# module is part of this installation. (The build fetches pugixml via
# FetchContent with FIND_PACKAGE_ARGS NAMES pugixml, so an adopter satisfies
# this by having pugixml discoverable through find_package -- e.g. a system or
# vcpkg/Conan package, or one installed from the same source.)
if(@NUCLEUS_XML_INSTALLED@)
    find_dependency(pugixml @NUCLEUS_PUGIXML_VERSION@)
endif()

# When the standard library lacks std::format the diagnostic seam falls back to
# {fmt}, which appears in a public header and therefore in the exported link
# interface. A consumer of the export must be able to resolve fmt::fmt, so the
# package requires fmt whenever the fallback was active at build time. (The build
# pulls fmt via FetchContent with FIND_PACKAGE_ARGS NAMES fmt, so an adopter
# satisfies this by having fmt discoverable through find_package -- e.g. a system
# or vcpkg/Conan package.)
if(@NUCLEUS_FMT_REQUIRED@)
    find_dependency(fmt @NUCLEUS_FMT_VERSION@)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/nucleus-targets.cmake")

# check_required_components() reports a component missing unless nucleus_<component>_FOUND
# is set, and nothing else sets it -- so without this every find_package(nucleus COMPONENTS
# ...) failed, whatever was actually installed. `core` maps onto nucleus::nucleus because
# core is exported under EXPORT_NAME nucleus; the nucleus::core spelling is an in-tree ALIAS
# and CMake does not export aliases.
if(TARGET nucleus::nucleus)
    set(nucleus_nucleus_FOUND TRUE)
    set(nucleus_core_FOUND TRUE)
else()
    set(nucleus_nucleus_FOUND FALSE)
    set(nucleus_core_FOUND FALSE)
endif()

foreach(_nucleus_component runtime env argv xml)
    if(TARGET nucleus::${_nucleus_component})
        set(nucleus_${_nucleus_component}_FOUND TRUE)
    else()
        set(nucleus_${_nucleus_component}_FOUND FALSE)
    endif()
endforeach()
unset(_nucleus_component)

# CMake's own refusal names only the package, never the component that went missing.
foreach(_nucleus_requested ${nucleus_FIND_COMPONENTS})
    if(NOT nucleus_${_nucleus_requested}_FOUND AND nucleus_FIND_REQUIRED_${_nucleus_requested})
        list(APPEND _nucleus_absent ${_nucleus_requested})
    endif()
endforeach()
unset(_nucleus_requested)

if(_nucleus_absent)
    list(JOIN _nucleus_absent ", " _nucleus_absent_text)
    set(nucleus_NOT_FOUND_MESSAGE
        "these required modules are not part of this nucleus installation: ${_nucleus_absent_text}")
    unset(_nucleus_absent_text)
endif()
unset(_nucleus_absent)

check_required_components(nucleus)
